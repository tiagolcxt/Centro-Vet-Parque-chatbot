# Copie para .env (não versionado) e troque os valores. Somente dados fictícios.

# Banco de desenvolvimento (compose.yml)
MYSQL_DATABASE=assistant
MYSQL_USER=assistant
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# OpenAI (lido pela aplicação e pelos testes @Tag("ai")). Sem aspas, sem espaços.
OPENAI_API_KEY=

# Chave da API do assistente (cabeçalho X-Api-Key, ADR-0012). Pelo menos 32 caracteres aleatórios.
# Gere com: openssl rand -hex 32
ASSISTANT_API_KEY=

# Base institucional (ADR-0003). Opcional: sem esta linha, usa config/clinic-knowledge.example.yml (tudo null).
# Para desenvolver com a clínica fictícia: file:config/clinic-knowledge.ficticia.yml
ASSISTANT_KNOWLEDGE_FILE=file:config/clinic-knowledge.ficticia.yml

# WhatsApp pela Cloud API (Etapa S4, ADR-0023). Opcional: sem estas linhas a aplicação sobe com o canal desligado.
# Nunca cole esses valores em chat, issue ou commit.
# App Secret do app na Meta (Configurações do app > Básico). Confere a assinatura do webhook.
WHATSAPP_APP_SECRET=
# Texto qualquer, combinado com a Meta ao cadastrar o webhook. Gere com: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# Chave que cifra o token de acesso guardado no banco: 32 bytes em Base64. Gere com: openssl rand -base64 32
# Trocar esta chave invalida o token salvo (é só salvar o token de novo na tela Canal WhatsApp).
WHATSAPP_TOKEN_KEY=

# Transcrição de áudio do tutor pela OpenAI (Etapa S5). Desligada por padrão até o suboperador ser aprovado (DA-50).
# ASSISTANT_AUDIO_ENABLED=true
