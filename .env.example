# Copie para .env (não versionado) e troque os valores. Somente dados fictícios.

# Banco de desenvolvimento (compose.yml)
MYSQL_DATABASE=assistant
MYSQL_USER=assistant
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# OpenAI (lido pela aplicação e pelos testes @Tag("ai")). Sem aspas, sem espaços.
OPENAI_API_KEY=

# Chave da API do assistente (cabeçalho X-Api-Key, ADR-0012). Pelo menos 32 caracteres aleatórios.
# Gere com: openssl rand -hex 32
ASSISTANT_API_KEY=
