# Finais de linha definidos pelo repositório, independentemente do core.autocrlf de cada máquina.
# No índice tudo é LF; no checkout, texto segue a plataforma, exceto as regras abaixo.
* text=auto

# Scripts de shell precisam de LF (rodam em Linux/CI).
/gradlew text eol=lf
*.sh     text eol=lf

# Scripts do Windows precisam de CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários: nunca converter.
*.jar  binary
*.png  binary
*.jpg  binary
*.pdf  binary
